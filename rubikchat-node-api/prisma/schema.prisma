// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Organization {
  id        String   @id @default(cuid())
  shop      String   @unique
  email     String
  token     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Agent     Agent[]
}

model Agent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  agentId        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model shopify_integrations {
  id                String   @id @default(cuid())
  store_name        String?
  store_url         String   @unique
  access_token      String
  scope             String?
  currency          String?
  timezone          String?
  status            String   @default("connected") // e.g. connected, pending, failed
  rubik_user_id     Int?
  rubik_organization_id Int?
  rubik_organization_slug String?
  rubik_agent_id    String?
  state_token       String?
  token_expires_at  DateTime?
  installation_date DateTime @default(now())
  updated_at        DateTime @updatedAt
}

model rubikchat_organizations {
  id         String   @id @default(cuid())
  store_url  String   @unique
  store_name String?
  email      String
  password   String?
  token      String?
  mcp_api_id String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  agents     rubikchat_agents[]
}

model rubikchat_agents {
  id              String                  @id @default(cuid())
  organization_id String
  organization    rubikchat_organizations @relation(fields: [organization_id], references: [id])
  agent_id        String
  created_at      DateTime                @default(now())
  updated_at      DateTime                @updatedAt
}

model api_logs {
  id         String   @id @default(cuid())
  endpoint   String
  method     String
  status     Int
  request    String?
  response   String?
  created_at DateTime @default(now())
}
