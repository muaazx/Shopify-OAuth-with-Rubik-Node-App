// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model shopify_integrations {
  id                String   @id @default(cuid())
  store_name        String?
  store_url         String   @unique
  access_token      String
  scope             String?
  currency          String?
  timezone          String?
  status            String   @default("connected") // e.g. connected, pending, failed
  installation_date DateTime @default(now())
  updated_at        DateTime @updatedAt
}

model rubikchat_organizations {
  id         String   @id @default(cuid())
  store_url  String   @unique
  email      String
  password   String?
  token      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  agents     rubikchat_agents[]
}

model rubikchat_agents {
  id              String                  @id @default(cuid())
  organization_id String
  organization    rubikchat_organizations @relation(fields: [organization_id], references: [id])
  agent_id        String
  created_at      DateTime                @default(now())
  updated_at      DateTime                @updatedAt
}

model api_logs {
  id         String   @id @default(cuid())
  endpoint   String
  method     String
  status     Int
  request    String?
  response   String?
  created_at DateTime @default(now())
}
